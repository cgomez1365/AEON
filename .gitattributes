# Line endings — closes the permanently-dirty tree (F9, 2026-07-30).
#
# core.autocrlf=true wants CRLF in the working tree; the app writes JSON with
# LF. With no .gitattributes, all 17 block.manifest.json files showed as
# modified on every boot while `git diff --numstat` reported 0 0 — pure line-
# ending churn that was misread for months as "boot mutates manifests".
#
# After adding this file, renormalize the index once:
#   git add --renormalize .
* text=auto eol=lf

# Binary — never touch these.
*.png binary
*.jpg binary
*.jpeg binary
*.gif binary
*.ico binary
*.pdf binary
*.zip binary
*.gguf binary
*.exe binary
*.dll binary
*.dylib binary
*.so binary
*.lnk binary
*.woff binary
*.woff2 binary
*.ttf binary

# Windows launchers must keep CRLF or cmd.exe mis-parses them.
*.bat text eol=crlf
*.cmd text eol=crlf

# POSIX launchers must keep LF.
*.sh text eol=lf
launch.command text eol=lf
