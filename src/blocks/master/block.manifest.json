{
  "manifestVersion": "1.1.0",
  "id": "master",
  "label": "Master",
  "icon": "Cpu",
  "route": "/master",
  "description": "The canonical block. Every new block starts as a copy of this folder — manifest, UI, API, and widget contract in their reference form.",
  "category": "system",
  "tier": "core",
  "nav": {
    "group": "system",
    "order": 2,
    "label": "Master",
    "icon": "Cpu",
    "iconAsset": "/brand/block-icons/master.svg",
    "iconAssetPng": "/brand/block-icons/png/master.png",
    "hidden": false
  },
  "widget": {
    "endpoint": "/api/master/widget",
    "label": "Master",
    "refresh_ms": 30000
  },
  "requires": {
    "apis": [],
    "env": [],
    "local": [],
    "blocks": []
  },
  "provides": {
    "routes": true,
    "api": true,
    "models": []
  },
  "api_routes": true,
  "version": "1.0.0",
  "contract": {
    "inputs": [],
    "outputs": [],
    "events": [],
    "permissions": {
      "filesystem": "none",
      "network": "internal",
      "secrets": false,
      "shell": false,
      "ai": false
    },
    "storage": {
      "type": "json",
      "scope": "block",
      "local": {
        "indexed": false,
        "retention": "operational"
      },
      "access": "compatibility"
    },
    "memory": {
      "mode": "none",
      "indexed": false,
      "userConfigurable": false
    },
    "ai": {
      "canGenerate": false,
      "canAnalyze": false,
      "canAutomate": false,
      "roles": [],
      "role": "chat",
      "blurb": "Reference block — demonstrates the role/blurb shape; makes no live AI calls"
    },
    "targets": {
      "local": true,
      "vercel": true,
      "docker": true,
      "cloudflare": true
    },
    "commands": [
      {
        "cmd": "/blocks",
        "desc": "List every installed block and its readiness",
        "method": "GET",
        "route": "/api/master/registry",
        "mode": "instant",
        "display": "text"
      },
      {
        "cmd": "/install",
        "desc": "Install a block cartridge from an https URL or a dist-blocks name",
        "method": "POST",
        "route": "/api/store/install",
        "params": [
          "url",
          "name"
        ],
        "dangerous": true,
        "mode": "instant",
        "category": "system"
      },
      {
        "cmd": "/catalog",
        "desc": "List block cartridges available to install",
        "method": "GET",
        "route": "/api/store/catalog",
        "mode": "instant",
        "category": "system"
      },
      {
        "cmd": "/queue",
        "desc": "Show the build and install approval queue",
        "method": "GET",
        "route": "/api/build/queue",
        "mode": "instant",
        "category": "system"
      },
      {
        "cmd": "/data",
        "desc": "Read a block's saved data — /data cookbook  (omit block to list all)",
        "method": "GET",
        "route": "/api/god/data",
        "params": [{ "name": "block", "type": "string", "required": false }],
        "mode": "instant",
        "display": "text",
        "category": "system"
      }
    ],
    "settings_keys": [],
    "settings": [
      {
        "key": "widget_enabled",
        "label": "Dashboard widget",
        "desc": "Show this block's quick-view card on the dashboard",
        "type": "toggle",
        "default": true
      },
      {
        "key": "example_note",
        "label": "Example text setting",
        "desc": "Reference for the settings contract — blocks read this via blockSettings.master.example_note",
        "type": "text",
        "default": ""
      }
    ]
  },
  "routes": [
    {
      "method": "ALL",
      "path": "/master/*",
      "auth": true
    }
  ],
  "env": [],
  "ai": {
    "capabilities": [],
    "canGenerate": false,
    "canAnalyze": false,
    "canAutomate": false
  },
  "storage": {
    "provider": "json",
    "tables": [],
    "scope": "block"
  },
  "dependencies": [],
  "deployment": {
    "target": "any",
    "runtime": "nodejs"
  }
}