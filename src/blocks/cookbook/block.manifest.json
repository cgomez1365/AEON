{
  "manifestVersion": "1.1.0",
  "id": "cookbook",
  "label": "Cookbook",
  "icon": "BookOpen",
  "route": "/cookbook",
  "description": "Local AI model management with GPU probing, download, serve, and hardware fitness",
  "category": "tools",
  "tier": "plugin",
  "nav": {
    "group": "content",
    "order": 1,
    "label": "Cookbook",
    "icon": "BookOpen",
    "iconAsset": "/brand/block-icons/cookbook.svg",
    "iconAssetPng": "/brand/block-icons/png/cookbook.png",
    "hidden": false
  },
  "widget": null,
  "requires": {
    "apis": [],
    "env": [],
    "local": [
      "ollama"
    ],
    "blocks": [
      "fleet_control"
    ]
  },
  "provides": {
    "routes": true,
    "api": true,
    "models": []
  },
  "api_routes": true,
  "version": "1.0.0",
  "contract": {
    "inputs": [],
    "outputs": [],
    "events": [],
    "permissions": {
      "filesystem": "write",
      "network": "external",
      "secrets": false,
      "shell": true,
      "ai": false
    },
    "storage": {
      "type": "json",
      "scope": "block",
      "local": {
        "indexed": false,
        "retention": "operational"
      },
      "access": "compatibility"
    },
    "memory": {
      "mode": "none",
      "indexed": false,
      "userConfigurable": false
    },
    "ai": {
      "canGenerate": false,
      "canAnalyze": false,
      "canAutomate": false,
      "roles": []
    },
    "targets": {
      "local": true,
      "vercel": false,
      "docker": true,
      "cloudflare": false
    },
    "commands": [
      {
        "cmd": "/gpu",
        "desc": "Probe GPU hardware status",
        "method": "GET",
        "route": "/api/cookbook/gpus"
      },
      {
        "cmd": "/models",
        "desc": "List cached local models",
        "method": "GET",
        "route": "/api/model/cached"
      },
      {
        "cmd": "/model-pull",
        "desc": "Download a local model — /model-pull qwen3.5:4b (Ollama) or org/repo (HuggingFace)",
        "method": "POST",
        "route": "/api/model/download",
        "param": "repo_id",
        "dangerous": true
      }
    ],
    "settings_keys": [],
    "settings": []
  },
  "routes": [
    {
      "method": "ALL",
      "path": "/cookbook/*",
      "auth": true
    }
  ],
  "env": [],
  "ai": {
    "capabilities": [],
    "canGenerate": false,
    "canAnalyze": false,
    "canAutomate": false
  },
  "storage": {
    "provider": "json",
    "tables": [],
    "scope": "block"
  },
  "dependencies": [],
  "deployment": {
    "target": "local_required",
    "runtime": "local"
  }
}