{
  "manifestVersion": "1.1.0",
  "id": "deep_research",
  "label": "Deep Research",
  "icon": "FlaskConical",
  "route": "/research",
  "description": "Multi-step web research with LLM-in-the-loop agent pipeline",
  "category": "intelligence",
  "tier": "core",
  "nav": {
    "group": "content",
    "order": 2,
    "label": "Deep Research",
    "icon": "FlaskConical",
    "iconAsset": "/brand/block-icons/deep_research.svg",
    "iconAssetPng": "/brand/block-icons/png/deep_research.png",
    "hidden": false
  },
  "widget": null,
  "requires": {
    "apis": [
      "groq",
      "gemini",
      "supabase"
    ],
    "env": [
      "GROQ_API_KEY",
      "GEMINI_FREE_KEY_1",
      "GEMINI_PAID_KEY",
      "SUPABASE_URL",
      "SUPABASE_SERVICE_ROLE_KEY"
    ],
    "local": [],
    "blocks": []
  },
  "provides": {
    "routes": true,
    "api": true,
    "models": []
  },
  "api_routes": true,
  "version": "1.0.0",
  "contract": {
    "customizable": {
      "icon": true
    },
    "inputs": [],
    "outputs": [],
    "events": [],
    "permissions": {
      "filesystem": "write",
      "network": "external",
      "secrets": true,
      "shell": true,
      "ai": true
    },
    "storage": {
      "type": "json",
      "scope": "block",
      "local": {
        "indexed": false,
        "retention": "operational"
      },
      "access": "compatibility"
    },
    "memory": {
      "mode": "summary",
      "indexed": true,
      "userConfigurable": false
    },
    "ai": {
      "canGenerate": false,
      "canAnalyze": false,
      "canAutomate": false,
      "roles": [],
      "role": "research",
      "blurb": "Runs deep research reports"
    },
    "targets": {
      "local": true,
      "vercel": true,
      "cloudflare": true
    },
    "commands": [
      {
        "cmd": "/scrape",
        "desc": "Scrape a URL via Orion",
        "method": "POST",
        "route": "/api/orion-scrape",
        "param": "url",
        "mode": "instant"
      }
    ],
    "settings_keys": [],
    "settings": []
  },
  "routes": [
    {
      "method": "ALL",
      "path": "/research/*",
      "auth": true
    }
  ],
  "env": [
    "GROQ_API_KEY",
    "GEMINI_FREE_KEY_1",
    "GEMINI_PAID_KEY",
    "SUPABASE_URL",
    "SUPABASE_SERVICE_ROLE_KEY"
  ],
  "ai": {
    "capabilities": [],
    "canGenerate": false,
    "canAnalyze": false,
    "canAutomate": false
  },
  "storage": {
    "provider": "json",
    "tables": [],
    "scope": "block"
  },
  "dependencies": [],
  "deployment": {
    "target": "universal",
    "runtime": "any"
  }
}