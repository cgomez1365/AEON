{
  "manifestVersion": "1.1.0",
  "id": "settings",
  "label": "Settings",
  "icon": "Settings",
  "route": "/settings",
  "description": "System configuration — API keys, model-per-role assignment, and block management",
  "category": "core",
  "tier": "core",
  "nav": {
    "group": "system",
    "order": 0,
    "label": "Settings",
    "icon": "Settings",
    "iconAsset": "/brand/block-icons/settings.svg",
    "iconAssetPng": "/brand/block-icons/png/settings.png",
    "hidden": false
  },
  "widget": null,
  "requires": {
    "apis": [],
    "env": [],
    "local": [],
    "blocks": []
  },
  "provides": {
    "routes": true,
    "api": true,
    "models": []
  },
  "api_routes": true,
  "version": "1.0.0",
  "contract": {
    "customizable": {
      "icon": true
    },
    "inputs": [],
    "outputs": [],
    "events": [],
    "permissions": {
      "filesystem": "write",
      "network": "external",
      "secrets": true,
      "shell": true,
      "ai": true
    },
    "storage": {
      "type": "json",
      "scope": "block",
      "local": {
        "indexed": false,
        "retention": "operational"
      },
      "access": "compatibility"
    },
    "memory": {
      "mode": "none",
      "indexed": false,
      "userConfigurable": false
    },
    "ai": {
      "canGenerate": false,
      "canAnalyze": false,
      "canAutomate": false,
      "roles": [],
      "role": "chat",
      "blurb": "Powers per-role model resolution for /set and connection tests"
    },
    "targets": {
      "local": true,
      "vercel": true,
      "cloudflare": true
    },
    "commands": [
      {
        "cmd": "/set",
        "desc": "Change a setting in plain English — e.g. \"set chat to local qwen3-4b-q4\"",
        "method": "POST",
        "route": "/api/settings/nl",
        "param": "phrase",
        "mode": "instant",
        "category": "system"
      },
      {
        "cmd": "/settings",
        "desc": "Show what is configured and what is still missing",
        "method": "GET",
        "route": "/api/settings/setup-status",
        "mode": "instant",
        "category": "system"
      },
      {
        "cmd": "/providers",
        "desc": "List AI providers, their models, and which ones have keys",
        "method": "GET",
        "route": "/api/settings/nervous-system",
        "mode": "instant",
        "category": "system"
      },
      {
        "cmd": "/restart",
        "desc": "Restart AEON to apply configuration changes",
        "method": "POST",
        "route": "/api/settings/restart",
        "dangerous": true,
        "mode": "instant",
        "category": "system"
      },
      {
        "cmd": "/addkey",
        "desc": "Add an API key — /addkey groq gsk_…",
        "method": "POST",
        "route": "/api/console/keys",
        "param": "arg",
        "mode": "instant",
        "category": "system"
      }
    ],
    "filesystem": {
      "beyondNamespace": [
        {
          "file": "api/settings.js",
          "scope": "install",
          "reason": "Reads and writes install-level settings and block manifests, which are kernel-owned rather than block-scoped."
        },
        {
          "file": "api/connectivity.js",
          "scope": "install",
          "reason": "Reads the db/ migration files it offers the operator to apply, which live outside any block namespace."
        }
      ]
    },
    "settings_keys": [],
    "settings": []
  },
  "routes": [
    {
      "method": "GET",
      "path": "/api/connections",
      "auth": true
    },
    {
      "method": "POST",
      "path": "/api/connections",
      "auth": true
    },
    {
      "method": "DELETE",
      "path": "/api/connections/:id",
      "auth": true
    },
    {
      "method": "POST",
      "path": "/api/connections/assign-role",
      "auth": true
    },
    {
      "method": "POST",
      "path": "/api/connections/detect",
      "auth": true
    },
    {
      "method": "POST",
      "path": "/api/connections/discover",
      "auth": true
    },
    {
      "method": "GET",
      "path": "/api/connections/resolve/:role",
      "auth": true
    },
    {
      "method": "GET",
      "path": "/api/connections/scan-all",
      "auth": true
    },
    {
      "method": "POST",
      "path": "/api/connections/sync",
      "auth": true
    },
    {
      "method": "GET",
      "path": "/api/prefs/:key",
      "auth": true
    },
    {
      "method": "PUT",
      "path": "/api/prefs/:key",
      "auth": true
    },
    {
      "method": "GET",
      "path": "/api/settings",
      "auth": true
    },
    {
      "method": "POST",
      "path": "/api/settings",
      "auth": true
    },
    {
      "method": "GET",
      "path": "/api/settings/block-config",
      "auth": true
    },
    {
      "method": "POST",
      "path": "/api/settings/block-config",
      "auth": true
    },
    {
      "method": "POST",
      "path": "/api/settings/block-config/auto",
      "auth": true
    },
    {
      "method": "POST",
      "path": "/api/settings/block-layout",
      "auth": true
    },
    {
      "method": "GET",
      "path": "/api/settings/block/:id",
      "auth": true
    },
    {
      "method": "GET",
      "path": "/api/settings/blocks",
      "auth": true
    },
    {
      "method": "DELETE",
      "path": "/api/settings/cloud-provider/:provider",
      "auth": true
    },
    {
      "method": "GET",
      "path": "/api/settings/connectivity",
      "auth": true
    },
    {
      "method": "POST",
      "path": "/api/settings/connectivity/firebase/save",
      "auth": true
    },
    {
      "method": "POST",
      "path": "/api/settings/connectivity/firebase/test",
      "auth": true
    },
    {
      "method": "GET",
      "path": "/api/settings/connectivity/public-config",
      "auth": true
    },
    {
      "method": "POST",
      "path": "/api/settings/connectivity/supabase/save",
      "auth": true
    },
    {
      "method": "POST",
      "path": "/api/settings/connectivity/supabase/setup",
      "auth": true
    },
    {
      "method": "POST",
      "path": "/api/settings/connectivity/supabase/sync",
      "auth": true
    },
    {
      "method": "POST",
      "path": "/api/settings/connectivity/supabase/test",
      "auth": true
    },
    {
      "method": "POST",
      "path": "/api/settings/connectivity/tunnel/start",
      "auth": true
    },
    {
      "method": "POST",
      "path": "/api/settings/connectivity/tunnel/stop",
      "auth": true
    },
    {
      "method": "POST",
      "path": "/api/settings/env",
      "auth": true
    },
    {
      "method": "GET",
      "path": "/api/settings/export-bundle",
      "auth": true
    },
    {
      "method": "GET",
      "path": "/api/settings/export-credentials",
      "auth": true
    },
    {
      "method": "GET",
      "path": "/api/settings/first-run",
      "auth": true
    },
    {
      "method": "POST",
      "path": "/api/settings/first-run/complete",
      "auth": true
    },
    {
      "method": "GET",
      "path": "/api/settings/nervous-system",
      "auth": true
    },
    {
      "method": "POST",
      "path": "/api/settings/nl",
      "auth": true
    },
    {
      "method": "GET",
      "path": "/api/settings/provider-blocks",
      "auth": true
    },
    {
      "method": "GET",
      "path": "/api/settings/provider-details",
      "auth": true
    },
    {
      "method": "GET",
      "path": "/api/settings/providers",
      "auth": true
    },
    {
      "method": "GET",
      "path": "/api/settings/resolve-endpoint",
      "auth": true
    },
    {
      "method": "POST",
      "path": "/api/settings/restart",
      "auth": true
    },
    {
      "method": "POST",
      "path": "/api/settings/secrets",
      "auth": true
    },
    {
      "method": "GET",
      "path": "/api/settings/setup-status",
      "auth": true
    },
    {
      "method": "POST",
      "path": "/api/settings/test-provider/:id",
      "auth": true
    }
  ],
  "env": [],
  "ai": {
    "capabilities": [],
    "canGenerate": false,
    "canAnalyze": false,
    "canAutomate": false
  },
  "storage": {
    "provider": "json",
    "tables": [],
    "scope": "block"
  },
  "dependencies": [],
  "deployment": {
    "target": "universal",
    "runtime": "any"
  }
}