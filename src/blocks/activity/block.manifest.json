{
  "manifestVersion": "1.0.0",
  "id": "activity",
  "label": "Activity",
  "icon": "📊",
  "route": "/activity",
  "description": "GitHub-style 365-day token usage heatmap with model breakdown",
  "category": "analytics",
  "tier": "core",
  "nav": {
    "group": "system",
    "order": 1,
    "label": "Activity",
    "icon": "📊",
    "hidden": false
  },
  "widget": null,
  "requires": {
    "apis": [
      "supabase"
    ],
    "env": [
      "SUPABASE_URL",
      "SUPABASE_SERVICE_ROLE_KEY"
    ],
    "local": [],
    "blocks": []
  },
  "provides": {
    "routes": true,
    "api": true,
    "models": []
  },
  "api_routes": true,
  "version": "1.0.0",
  "contract": {
    "inputs": [],
    "outputs": [],
    "events": [],
    "permissions": {
      "filesystem": "write",
      "network": "external",
      "secrets": true,
      "shell": false,
      "ai": false
    },
    "storage": {
      "type": "json",
      "scope": "block"
    },
    "ai": {
      "canGenerate": false,
      "canAnalyze": false,
      "canAutomate": false,
      "roles": []
    },
    "targets": {
      "local": true,
      "vercel": true,
      "docker": true,
      "cloudflare": true
    },
    "commands": [],
    "settings_keys": [],
    "settings": []
  },
  "routes": [
    {
      "method": "GET",
      "path": "/api/token-analytics/heatmap",
      "auth": false
    },
    {
      "method": "GET",
      "path": "/api/token-analytics/summary",
      "auth": false
    },
    {
      "method": "GET",
      "path": "/api/token-analytics/daily/:date",
      "auth": false
    },
    {
      "method": "POST",
      "path": "/api/token-analytics/record",
      "auth": false
    },
    {
      "method": "POST",
      "path": "/api/search",
      "auth": false
    },
    {
      "method": "GET",
      "path": "/api/telemetry",
      "auth": false
    },
    {
      "method": "GET",
      "path": "/api/telemetry/live",
      "auth": false
    },
    {
      "method": "GET",
      "path": "/api/pipeline-metrics",
      "auth": false
    },
    {
      "method": "GET",
      "path": "/api/audit",
      "auth": false
    },
    {
      "method": "POST",
      "path": "/api/audit",
      "auth": false
    }
  ],
  "env": [
    "SUPABASE_URL",
    "SUPABASE_SERVICE_ROLE_KEY"
  ],
  "ai": {
    "capabilities": [],
    "canGenerate": false,
    "canAnalyze": false,
    "canAutomate": false
  },
  "storage": {
    "provider": "json",
    "tables": [],
    "scope": "block"
  },
  "dependencies": [],
  "deployment": {
    "target": "universal",
    "runtime": "any"
  }
