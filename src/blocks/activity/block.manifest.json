{
  "manifestVersion": "1.1.0",
  "id": "activity",
  "label": "Activity",
  "icon": "Activity",
  "route": "/activity",
  "description": "GitHub-style 365-day token usage heatmap with model breakdown",
  "category": "analytics",
  "tier": "core",
  "nav": {
    "group": "system",
    "order": 1,
    "label": "Activity",
    "icon": "Activity",
    "iconAsset": "/brand/block-icons/activity.svg",
    "iconAssetPng": "/brand/block-icons/png/activity.png",
    "hidden": false
  },
  "widget": null,
  "requires": {
    "apis": [],
    "env": [],
    "local": [],
    "blocks": []
  },
  "provides": {
    "routes": true,
    "api": true,
    "models": []
  },
  "api_routes": true,
  "version": "1.0.0",
  "contract": {
    "customizable": {
      "icon": true
    },
    "inputs": [],
    "outputs": [],
    "events": [],
    "permissions": {
      "filesystem": "write",
      "network": "external",
      "secrets": true,
      "shell": false,
      "ai": false
    },
    "storage": {
      "type": "json",
      "scope": "block",
      "local": {
        "indexed": false,
        "retention": "operational"
      },
      "access": "compatibility"
    },
    "memory": {
      "mode": "none",
      "indexed": false,
      "userConfigurable": false
    },
    "ai": {
      "canGenerate": false,
      "canAnalyze": false,
      "canAutomate": false,
      "roles": []
    },
    "targets": {
      "local": true,
      "vercel": true,
      "cloudflare": true
    },
    "commands": [],
    "filesystem": {
      "beyondNamespace": [
        {
          "file": "api/analytics.cjs",
          "scope": "install",
          "reason": "Reads and appends the kernel audit log and reads the kernel's LLM call ledger — install-level files, not this block's data."
        },
        {
          "file": "api/token-analytics.cjs",
          "scope": "install",
          "reason": "Reads the kernel's LLM call ledger, which is kernel-owned state rather than this block's data."
        }
      ]
    },
    "settings_keys": [],
    "settings": []
  },
  "routes": [
    {
      "method": "GET",
      "path": "/api/audit",
      "auth": true
    },
    {
      "method": "POST",
      "path": "/api/audit",
      "auth": true
    },
    {
      "method": "GET",
      "path": "/api/telemetry",
      "auth": true
    },
    {
      "method": "GET",
      "path": "/api/token-analytics/calls",
      "auth": true
    },
    {
      "method": "GET",
      "path": "/api/token-analytics/daily/:date",
      "auth": true
    },
    {
      "method": "GET",
      "path": "/api/token-analytics/heatmap",
      "auth": true
    },
    {
      "method": "POST",
      "path": "/api/token-analytics/record",
      "auth": true
    },
    {
      "method": "GET",
      "path": "/api/token-analytics/summary",
      "auth": true
    }
  ],
  "env": [],
  "ai": {
    "capabilities": [],
    "canGenerate": false,
    "canAnalyze": false,
    "canAutomate": false
  },
  "storage": {
    "provider": "json",
    "tables": [],
    "scope": "block"
  },
  "dependencies": [],
  "deployment": {
    "target": "universal",
    "runtime": "any"
  }
}