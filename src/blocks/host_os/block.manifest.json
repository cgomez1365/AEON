{
  "manifestVersion": "1.1.0",
  "id": "host_os",
  "label": "Host OS",
  "icon": "Monitor",
  "route": "/host",
  "description": "Kernel-level access to the host file system, terminal operations, processes, and operating system metrics.",
  "category": "System",
  "tier": "core",
  "nav": {
    "group": "tools",
    "order": 0,
    "label": "Host OS",
    "icon": "Monitor",
    "iconAsset": "/brand/block-icons/host_os.svg",
    "iconAssetPng": "/brand/block-icons/png/host_os.png",
    "hidden": false
  },
  "widget": {
    "endpoint": "/api/host_os/widget",
    "label": "Operator Console",
    "refresh_ms": 30000
  },
  "requires": {
    "apis": [],
    "env": [],
    "local": [],
    "blocks": []
  },
  "provides": {
    "routes": true,
    "api": true,
    "models": []
  },
  "api_routes": true,
  "version": "1.0.0",
  "contract": {
    "customizable": {
      "icon": true
    },
    "inputs": [],
    "outputs": [],
    "events": [],
    "permissions": {
      "filesystem": "write",
      "network": "internal",
      "secrets": false,
      "shell": true,
      "ai": false
    },
    "storage": {
      "type": "json",
      "scope": "block",
      "local": {
        "indexed": false,
        "retention": "operational"
      },
      "access": "compatibility"
    },
    "memory": {
      "mode": "summary",
      "indexed": true,
      "userConfigurable": false
    },
    "ai": {
      "canGenerate": false,
      "canAnalyze": false,
      "canAutomate": false,
      "roles": []
    },
    "targets": {
      "local": true,
      "vercel": false,
      "cloudflare": true
    },
    "commands": [
      {
        "cmd": "/scan",
        "desc": "Scan matrix & sync to Supabase",
        "method": "POST",
        "route": "/api/system/scan",
        "mode": "instant"
      },
      {
        "cmd": "/autopilot-status",
        "desc": "Auto-Pilot daemon status",
        "method": "GET",
        "route": "/api/autopilot/status",
        "mode": "instant"
      },
      {
        "cmd": "/autopilot-start",
        "desc": "Start the Auto-Pilot daemon",
        "method": "POST",
        "route": "/api/autopilot/start",
        "mode": "instant",
        "dangerous": true
      },
      {
        "cmd": "/autopilot-stop",
        "desc": "Stop the Auto-Pilot daemon",
        "method": "POST",
        "route": "/api/autopilot/stop",
        "mode": "instant"
      },
      {
        "cmd": "/upload",
        "desc": "Auto-Pilot: upload now",
        "method": "POST",
        "route": "/api/autopilot/upload-now",
        "mode": "instant"
      },
      {
        "cmd": "/read",
        "desc": "Read a file from the workspace",
        "method": "POST",
        "route": "/api/fs/read",
        "param": "filePath",
        "mode": "instant",
        "category": "content",
        "argRequired": true,
        "argHint": "<filePath>"
      },
      {
        "cmd": "/writefile",
        "desc": "Write a file in the workspace",
        "method": "POST",
        "route": "/api/fs/write",
        "params": [
          "filePath",
          "content"
        ],
        "dangerous": true,
        "mode": "instant",
        "category": "content",
        "argHint": "<filePath> <content>"
      }
    ],
    "filesystem": {
      "beyondNamespace": [
        {
          "file": "api/fs.cjs",
          "scope": "workspace",
          "reason": "This IS the File Manager. Browsing and editing the operator's workspace is the feature; scoping it to a block namespace would remove it."
        },
        {
          "file": "api/os.cjs",
          "scope": "workspace",
          "reason": "Named OS operations act on the operator's machine by design, under the allowlist in the kernel's execution surface."
        },
        {
          "file": "api/system.cjs",
          "scope": "install",
          "reason": "Reads the kernel's audit and violation logs to report system health, which are install-level files."
        }
      ]
    },
    "settings_keys": [],
    "settings": []
  },
  "routes": [
    {
      "method": "GET",
      "path": "/api/desktop-tasks",
      "auth": true
    },
    {
      "method": "POST",
      "path": "/api/desktop-tasks",
      "auth": true
    },
    {
      "method": "POST",
      "path": "/api/force-sync",
      "auth": true
    },
    {
      "method": "POST",
      "path": "/api/fs/delete",
      "auth": true
    },
    {
      "method": "POST",
      "path": "/api/fs/list",
      "auth": true
    },
    {
      "method": "GET",
      "path": "/api/fs/lock",
      "auth": true
    },
    {
      "method": "POST",
      "path": "/api/fs/lock",
      "auth": true
    },
    {
      "method": "POST",
      "path": "/api/fs/mkdir",
      "auth": true
    },
    {
      "method": "POST",
      "path": "/api/fs/read",
      "auth": true
    },
    {
      "method": "POST",
      "path": "/api/fs/rename",
      "auth": true
    },
    {
      "method": "GET",
      "path": "/api/fs/serve",
      "auth": true
    },
    {
      "method": "POST",
      "path": "/api/fs/upload",
      "auth": true
    },
    {
      "method": "POST",
      "path": "/api/fs/write",
      "auth": true
    },
    {
      "method": "GET",
      "path": "/api/gas/status",
      "auth": true
    },
    {
      "method": "GET",
      "path": "/api/health",
      "auth": true
    },
    {
      "method": "GET",
      "path": "/api/host_os/audit",
      "auth": true
    },
    {
      "method": "POST",
      "path": "/api/host_os/safe-mode",
      "auth": true
    },
    {
      "method": "GET",
      "path": "/api/host_os/widget",
      "auth": true
    },
    {
      "method": "POST",
      "path": "/api/os/action",
      "auth": true
    },
    {
      "method": "GET",
      "path": "/api/os/actions",
      "auth": true
    },
    {
      "method": "POST",
      "path": "/api/os/open",
      "auth": true
    },
    {
      "method": "GET",
      "path": "/api/sdi/schemas",
      "auth": true
    },
    {
      "method": "POST",
      "path": "/api/sdi/validate",
      "auth": true
    },
    {
      "method": "GET",
      "path": "/api/sdi/violations",
      "auth": true
    },
    {
      "method": "POST",
      "path": "/api/system/restart",
      "auth": true
    },
    {
      "method": "POST",
      "path": "/api/system/scan",
      "auth": true
    }
  ],
  "env": [],
  "ai": {
    "capabilities": [],
    "canGenerate": false,
    "canAnalyze": false,
    "canAutomate": false
  },
  "storage": {
    "provider": "json",
    "tables": [],
    "scope": "block"
  },
  "dependencies": [],
  "deployment": {
    "target": "local",
    "runtime": "nodejs"
  }
}