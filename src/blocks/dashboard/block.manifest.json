{
  "manifestVersion": "1.0.0",
  "id": "dashboard",
  "label": "Dashboard",
  "icon": "⚡",
  "route": "/",
  "description": "Unified command hub with live LLM telemetry, API spend, activity heatmap, and live audit feed",
  "category": "core",
  "tier": "core",
  "nav": {
    "group": "finance",
    "order": 0,
    "label": "Dashboard",
    "icon": "⚡",
    "hidden": false
  },
  "widget": null,
  "requires": {
    "apis": [
      "supabase",
      "groq",
      "gemini",
      "ollama"
    ],
    "env": [
      "SUPABASE_URL",
      "SUPABASE_SERVICE_ROLE_KEY",
      "OLLAMA_HOST"
    ],
    "local": [],
    "blocks": []
  },
  "provides": {
    "routes": true,
    "api": true,
    "models": []
  },
  "api_routes": true,
  "version": "1.0.0",
  "contract": {
    "inputs": [],
    "outputs": [],
    "events": [],
    "permissions": {
      "filesystem": "write",
      "network": "external",
      "secrets": true,
      "shell": false,
      "ai": true
    },
    "storage": {
      "type": "json",
      "scope": "block"
    },
    "ai": {
      "canGenerate": false,
      "canAnalyze": false,
      "canAutomate": false,
      "roles": [],
      "role": "chat",
      "blurb": "Powers the Neural Terminal chat"
    },
    "targets": {
      "local": true,
      "vercel": true,
      "docker": true,
      "cloudflare": true
    },
    "commands": [
      {
        "cmd": "/note",
        "desc": "Save a quick note",
        "method": "POST",
        "route": "/api/notes",
        "param": "content",
        "mode": "instant"
      },
      {
        "cmd": "/push",
        "desc": "Push all blocks to Supabase cloud",
        "method": "POST",
        "route": "/api/sync/bulk-push",
        "mode": "instant",
        "dangerous": true
      },
      {
        "cmd": "/pull",
        "desc": "Pull all blocks from Supabase cloud",
        "method": "POST",
        "route": "/api/sync/bulk-pull",
        "mode": "instant",
        "dangerous": true
      }
    ],
    "settings_keys": [],
    "settings": []
  },
  "routes": [
    {
      "method": "GET",
      "path": "/api/chat",
      "auth": false
    },
    {
      "method": "POST",
      "path": "/api/chat",
      "auth": false
    },
    {
      "method": "DELETE",
      "path": "/api/chat",
      "auth": false
    },
    {
      "method": "GET",
      "path": "/api/terminal-stream",
      "auth": false
    },
    {
      "method": "GET",
      "path": "/api/terminal-history",
      "auth": false
    },
    {
      "method": "POST",
      "path": "/api/terminal-history",
      "auth": false
    },
    {
      "method": "POST",
      "path": "/api/chat/stream",
      "auth": false
    },
    {
      "method": "POST",
      "path": "/api/chat/stop",
      "auth": false
    },
    {
      "method": "GET",
      "path": "/api/audit",
      "auth": false
    },
    {
      "method": "POST",
      "path": "/api/audit",
      "auth": false
    },
    {
      "method": "GET",
      "path": "/api/health",
      "auth": false
    },
    {
      "method": "GET",
      "path": "/api/pipeline-metrics",
      "auth": false
    }
  ],
  "env": [
    "SUPABASE_URL",
    "SUPABASE_SERVICE_ROLE_KEY",
    "OLLAMA_HOST"
  ],
  "ai": {
    "capabilities": [],
    "canGenerate": false,
    "canAnalyze": false,
    "canAutomate": false
  },
  "storage": {
    "provider": "json",
    "tables": [],
    "scope": "block"
  },
  "dependencies": [],
  "deployment": {
    "target": "universal",
    "runtime": "any"
  }
}