{
  "manifestVersion": "1.1.0",
  "id": "dashboard",
  "label": "Dashboard",
  "icon": "CircleGauge",
  "route": "/",
  "description": "Unified command hub with live LLM telemetry, API spend, activity heatmap, and live audit feed",
  "category": "core",
  "tier": "core",
  "nav": {
    "group": "finance",
    "order": 0,
    "label": "Dashboard",
    "icon": "CircleGauge",
    "iconAsset": "/brand/block-icons/dashboard.svg",
    "iconAssetPng": "/brand/block-icons/png/dashboard.png",
    "hidden": false
  },
  "widget": null,
  "requires": {
    "apis": [
      "supabase",
      "groq",
      "gemini",
      "local"
    ],
    "env": [
      "SUPABASE_URL",
      "SUPABASE_SERVICE_ROLE_KEY",
      "AEON_LLM_BACKEND"
    ],
    "local": [],
    "blocks": []
  },
  "provides": {
    "routes": true,
    "api": true,
    "models": []
  },
  "api_routes": true,
  "version": "1.0.0",
  "contract": {
    "customizable": {
      "icon": true
    },
    "inputs": [],
    "outputs": [],
    "events": [],
    "permissions": {
      "filesystem": "write",
      "network": "external",
      "secrets": true,
      "shell": false,
      "ai": true
    },
    "storage": {
      "type": "json",
      "scope": "block",
      "local": {
        "indexed": false,
        "retention": "operational"
      },
      "access": "compatibility"
    },
    "memory": {
      "mode": "none",
      "indexed": false,
      "userConfigurable": false
    },
    "ai": {
      "canGenerate": false,
      "canAnalyze": false,
      "canAutomate": false,
      "roles": [],
      "role": "chat",
      "blurb": "Powers the Neural Terminal chat"
    },
    "targets": {
      "local": true,
      "vercel": true,
      "cloudflare": true
    },
    "commands": [],
    "filesystem": {
      "beyondNamespace": [
        {
          "file": "api/chat.cjs",
          "scope": "vault",
          "reason": "Chat history is persisted to shared storage so the terminal and dashboard read one transcript."
        },
        {
          "file": "api/chat-stream.cjs",
          "scope": "vault",
          "reason": "The streaming chat path writes the same shared transcript as the non-streaming one."
        }
      ]
    },
    "settings_keys": [],
    "settings": []
  },
  "routes": [
    {
      "method": "ALL",
      "path": "/api/audit",
      "auth": true
    },
    {
      "method": "DELETE",
      "path": "/api/chat",
      "auth": true
    },
    {
      "method": "GET",
      "path": "/api/chat",
      "auth": true
    },
    {
      "method": "POST",
      "path": "/api/chat",
      "auth": true
    },
    {
      "method": "POST",
      "path": "/api/chat/stop",
      "auth": true
    },
    {
      "method": "POST",
      "path": "/api/chat/stream",
      "auth": true
    },
    {
      "method": "ALL",
      "path": "/api/health",
      "auth": true
    },
    {
      "method": "ALL",
      "path": "/api/pipeline-metrics",
      "auth": true
    },
    {
      "method": "GET",
      "path": "/api/terminal-history",
      "auth": true
    },
    {
      "method": "POST",
      "path": "/api/terminal-history",
      "auth": true
    },
    {
      "method": "GET",
      "path": "/api/terminal-stream",
      "auth": true
    },
    {
      "method": "GET",
      "path": "/api/terminal/sessions",
      "auth": true
    },
    {
      "method": "POST",
      "path": "/api/terminal/sessions",
      "auth": true
    },
    {
      "method": "DELETE",
      "path": "/api/terminal/sessions/:id",
      "auth": true
    },
    {
      "method": "GET",
      "path": "/api/terminal/sessions/:id",
      "auth": true
    }
  ],
  "env": [
    "SUPABASE_URL",
    "SUPABASE_SERVICE_ROLE_KEY",
    "AEON_LLM_BACKEND"
  ],
  "ai": {
    "capabilities": [],
    "canGenerate": false,
    "canAnalyze": false,
    "canAutomate": false
  },
  "storage": {
    "provider": "json",
    "tables": [],
    "scope": "block"
  },
  "dependencies": [],
  "deployment": {
    "target": "universal",
    "runtime": "any"
  }
}