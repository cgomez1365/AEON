{
  "manifestVersion": "1.1.0",
  "id": "aeon_matrix",
  "label": "Aeon Matrix",
  "icon": "Workflow",
  "route": "/brain",
  "description": "The knowledge graph, document library, reading vault, and saved artifacts — AEON's long-term memory and human file system.",
  "category": "Knowledge",
  "tier": "plugin",
  "nav": {
    "group": "content",
    "order": 4,
    "label": "Aeon Matrix",
    "icon": "Workflow",
    "iconAsset": "/brand/block-icons/aeon_matrix.svg",
    "iconAssetPng": "/brand/block-icons/png/aeon_matrix.png",
    "hidden": false
  },
  "widget": null,
  "requires": {
    "apis": [
      "gemini",
      "local",
      "supabase"
    ],
    "env": [
      "GEMINI_PAID_KEY",
      "GEMINI_API_KEY",
      "GEMINI_FREE_KEY_1",
      "AEON_LLM_BACKEND",
      "SUPABASE_URL",
      "SUPABASE_SERVICE_ROLE_KEY"
    ],
    "local": [],
    "blocks": []
  },
  "provides": {
    "routes": true,
    "api": true,
    "models": []
  },
  "api_routes": true,
  "version": "1.0.0",
  "contract": {
    "customizable": {
      "icon": true
    },
    "inputs": [],
    "outputs": [],
    "events": [],
    "permissions": {
      "filesystem": "write",
      "network": "external",
      "secrets": true,
      "shell": false,
      "ai": true
    },
    "storage": {
      "type": "json",
      "scope": "block",
      "local": {
        "indexed": false,
        "retention": "operational"
      },
      "access": "compatibility"
    },
    "memory": {
      "mode": "document",
      "indexed": true,
      "userConfigurable": false
    },
    "ai": {
      "canGenerate": false,
      "canAnalyze": false,
      "canAutomate": false,
      "roles": [],
      "role": "chat",
      "blurb": "Answers questions about your documents"
    },
    "targets": {
      "local": true,
      "vercel": true,
      "cloudflare": true
    },
    "commands": [
      {
        "cmd": "/index-brain",
        "desc": "Rebuild the Second Brain index (new/changed/deleted files)",
        "method": "POST",
        "route": "/api/crn/second-brain/ingest/scan-docs",
        "mode": "instant"
      },
      {
        "cmd": "/vault-push",
        "desc": "Mirror Second Brain docs to Supabase for mobile",
        "method": "POST",
        "route": "/api/crn/second-brain/vault-push",
        "mode": "instant"
      },
      {
        "cmd": "/recall",
        "desc": "Semantic search the Second Brain — finds documents matching your query",
        "method": "POST",
        "route": "/api/crn/second-brain/retrieve",
        "params": [
          {
            "name": "query",
            "type": "string",
            "required": true
          }
        ],
        "mode": "instant"
      },
      {
        "cmd": "/tree",
        "desc": "List the vault folder structure (Vault, Reading_Library, Saved_Artifacts)",
        "method": "GET",
        "route": "/api/crn/second-brain/tree",
        "params": [
          {
            "name": "section",
            "type": "string",
            "required": false
          }
        ],
        "mode": "instant"
      },
      {
        "cmd": "/doc",
        "desc": "Read a document from the vault by relative path",
        "method": "GET",
        "route": "/api/crn/second-brain/document",
        "params": [
          {
            "name": "path",
            "type": "string",
            "required": true
          }
        ],
        "mode": "instant"
      }
    ],
    "settings_keys": [
      "aeon_matrix_settings"
    ],
    "settings": [
      {
        "key": "nodeStyle",
        "label": "Node style",
        "type": "select",
        "options": [
          "Solid orbs",
          "Fuzzy glow"
        ],
        "default": "Solid orbs",
        "scope": "browser"
      },
      {
        "key": "autoRotate",
        "label": "Auto rotate camera",
        "type": "boolean",
        "default": false,
        "scope": "browser"
      },
      {
        "key": "focusMode",
        "label": "Focus mode on hover",
        "type": "boolean",
        "default": false,
        "scope": "browser"
      }
    ]
  },
  "routes": [
    {
      "method": "GET",
      "path": "/api/crn/second-brain/document",
      "auth": true
    },
    {
      "method": "GET",
      "path": "/api/crn/second-brain/extract",
      "auth": true
    },
    {
      "method": "GET",
      "path": "/api/crn/second-brain/graph",
      "auth": true
    },
    {
      "method": "GET",
      "path": "/api/crn/second-brain/health",
      "auth": true
    },
    {
      "method": "GET",
      "path": "/api/crn/second-brain/index-status",
      "auth": true
    },
    {
      "method": "POST",
      "path": "/api/crn/second-brain/ingest/chat",
      "auth": true
    },
    {
      "method": "DELETE",
      "path": "/api/crn/second-brain/ingest/document",
      "auth": true
    },
    {
      "method": "POST",
      "path": "/api/crn/second-brain/ingest/document",
      "auth": true
    },
    {
      "method": "PUT",
      "path": "/api/crn/second-brain/ingest/document",
      "auth": true
    },
    {
      "method": "POST",
      "path": "/api/crn/second-brain/ingest/scan-docs",
      "auth": true
    },
    {
      "method": "GET",
      "path": "/api/crn/second-brain/pdf",
      "auth": true
    },
    {
      "method": "GET",
      "path": "/api/crn/second-brain/pdf-text",
      "auth": true
    },
    {
      "method": "GET",
      "path": "/api/crn/second-brain/raw",
      "auth": true
    },
    {
      "method": "POST",
      "path": "/api/crn/second-brain/retrieve",
      "auth": true
    },
    {
      "method": "GET",
      "path": "/api/crn/second-brain/search",
      "auth": true
    },
    {
      "method": "GET",
      "path": "/api/crn/second-brain/tree",
      "auth": true
    },
    {
      "method": "POST",
      "path": "/api/crn/second-brain/vault-push",
      "auth": true
    },
    {
      "method": "GET",
      "path": "/api/crn/second-brain/vault-push/status",
      "auth": true
    },
    {
      "method": "GET",
      "path": "/api/crn/second-brain/vendor/:file",
      "auth": true
    },
    {
      "method": "GET",
      "path": "/api/crn/second-brain/visualizer",
      "auth": true
    },
    {
      "method": "GET",
      "path": "/api/logistics/entries",
      "auth": true
    },
    {
      "method": "POST",
      "path": "/api/logistics/entries",
      "auth": true
    },
    {
      "method": "DELETE",
      "path": "/api/logistics/entries/:id",
      "auth": true
    },
    {
      "method": "POST",
      "path": "/api/logistics/sign",
      "auth": true
    },
    {
      "method": "POST",
      "path": "/api/logistics/status",
      "auth": true
    },
    {
      "method": "GET",
      "path": "/api/narrator/state",
      "auth": true
    },
    {
      "method": "POST",
      "path": "/api/narrator/state",
      "auth": true
    },
    {
      "method": "POST",
      "path": "/api/search",
      "auth": true
    },
    {
      "method": "GET",
      "path": "/api/sync/:block",
      "auth": true
    },
    {
      "method": "POST",
      "path": "/api/sync/:block",
      "auth": true
    },
    {
      "method": "POST",
      "path": "/api/sync/:block/patch",
      "auth": true
    },
    {
      "method": "POST",
      "path": "/api/sync/bulk-pull",
      "auth": true
    },
    {
      "method": "POST",
      "path": "/api/sync/bulk-push",
      "auth": true
    }
  ],
  "env": [
    "GEMINI_PAID_KEY",
    "GEMINI_API_KEY",
    "GEMINI_FREE_KEY_1",
    "AEON_LLM_BACKEND",
    "SUPABASE_URL",
    "SUPABASE_SERVICE_ROLE_KEY"
  ],
  "ai": {
    "capabilities": [],
    "canGenerate": false,
    "canAnalyze": false,
    "canAutomate": false
  },
  "storage": {
    "provider": "json",
    "tables": [],
    "scope": "block"
  },
  "dependencies": [],
  "deployment": {
    "target": "hybrid",
    "runtime": "nodejs"
  }
}