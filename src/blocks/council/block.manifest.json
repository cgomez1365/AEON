{
  "manifestVersion": "1.1.0",
  "id": "council",
  "label": "Council",
  "icon": "Landmark",
  "route": "/council",
  "description": "Multi-model deliberation council — a persistent roster debates a question and the chair writes a verdict, saved to the vault",
  "category": "tools",
  "tier": "plugin",
  "nav": {
    "group": "tools",
    "order": 1,
    "label": "Council",
    "icon": "Landmark",
    "iconAsset": "/brand/block-icons/council.svg",
    "iconAssetPng": "/brand/block-icons/png/council.png",
    "hidden": false
  },
  "widget": null,
  "requires": {
    "apis": [],
    "env": [],
    "local": [],
    "blocks": []
  },
  "provides": {
    "routes": true,
    "api": true,
    "models": []
  },
  "api_routes": true,
  "version": "1.0.0",
  "contract": {
    "customizable": {
      "icon": true
    },
    "inputs": [],
    "outputs": [],
    "events": [],
    "permissions": {
      "filesystem": "write",
      "network": "external",
      "secrets": true,
      "shell": false,
      "ai": true
    },
    "storage": {
      "type": "json",
      "scope": "block",
      "local": {
        "indexed": false,
        "retention": "operational"
      },
      "access": "compatibility"
    },
    "memory": {
      "mode": "document",
      "indexed": true,
      "userConfigurable": false
    },
    "ai": {
      "canGenerate": false,
      "canAnalyze": false,
      "canAutomate": false,
      "roles": [],
      "role": "chat",
      "blurb": "Convenes a roster of models to debate a question and writes a verdict"
    },
    "targets": {
      "local": true,
      "vercel": true,
      "cloudflare": true
    },
    "commands": [],
    "filesystem": {
      "beyondNamespace": [
        {
          "file": "api/index.cjs",
          "scope": "vault",
          "reason": "Debate transcripts are written to the shared Vault so they are searchable by the Second Brain, not kept private to this block."
        }
      ]
    },
    "settings_keys": [],
    "settings": []
  },
  "routes": [
    {
      "method": "DELETE",
      "path": "/api/compare/:compId",
      "auth": true
    },
    {
      "method": "POST",
      "path": "/api/compare/:compId/vote",
      "auth": true
    },
    {
      "method": "GET",
      "path": "/api/compare/history",
      "auth": true
    },
    {
      "method": "GET",
      "path": "/api/compare/models",
      "auth": true
    },
    {
      "method": "POST",
      "path": "/api/compare/record",
      "auth": true
    },
    {
      "method": "GET",
      "path": "/api/compare/scoreboard",
      "auth": true
    },
    {
      "method": "POST",
      "path": "/api/compare/start",
      "auth": true
    },
    {
      "method": "GET",
      "path": "/api/council/debate/:id",
      "auth": true
    },
    {
      "method": "POST",
      "path": "/api/council/debate/save",
      "auth": true
    },
    {
      "method": "GET",
      "path": "/api/council/debates",
      "auth": true
    },
    {
      "method": "GET",
      "path": "/api/council/members",
      "auth": true
    },
    {
      "method": "POST",
      "path": "/api/council/members",
      "auth": true
    },
    {
      "method": "DELETE",
      "path": "/api/council/members/:id",
      "auth": true
    },
    {
      "method": "PUT",
      "path": "/api/council/members/:id",
      "auth": true
    },
    {
      "method": "GET",
      "path": "/api/council/models",
      "auth": true
    }
  ],
  "env": [],
  "ai": {
    "capabilities": [],
    "canGenerate": false,
    "canAnalyze": false,
    "canAutomate": false
  },
  "storage": {
    "provider": "json",
    "tables": [],
    "scope": "block"
  },
  "dependencies": [],
  "deployment": {
    "target": "universal",
    "runtime": "any"
  }
}