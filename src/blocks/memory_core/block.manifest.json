{
  "manifestVersion": "1.1.0",
  "id": "memory_core",
  "label": "Memory Core",
  "icon": "Workflow",
  "route": "/memory_core",
  "description": "VP's persistent memory — typed facts (outline/algorithm/decision/milestone), vault-stored, injected into every terminal chat",
  "category": "core",
  "tier": "core",
  "nav": {
    "group": "system",
    "order": 99,
    "label": "Memory Core",
    "icon": "Workflow",
    "iconAsset": "/brand/block-icons/memory_core.svg",
    "iconAssetPng": "/brand/block-icons/png/memory_core.png",
    "hidden": false
  },
  "widget": null,
  "requires": {
    "apis": [],
    "env": [],
    "local": [],
    "blocks": []
  },
  "provides": {
    "routes": true,
    "api": true,
    "models": []
  },
  "api_routes": true,
  "version": "1.0.0",
  "contract": {
    "customizable": {
      "icon": true
    },
    "inputs": [],
    "outputs": [],
    "events": [],
    "permissions": {
      "filesystem": "write",
      "network": "internal",
      "secrets": false,
      "shell": false,
      "ai": true
    },
    "storage": {
      "type": "json",
      "scope": "global",
      "local": {
        "indexed": false,
        "retention": "operational"
      },
      "access": "compatibility"
    },
    "memory": {
      "mode": "document",
      "indexed": true,
      "userConfigurable": false
    },
    "ai": {
      "canGenerate": false,
      "canAnalyze": true,
      "canAutomate": false,
      "roles": [
        "chat"
      ],
      "role": "chat",
      "blurb": "Distills and recalls VP memory"
    },
    "targets": {
      "local": true,
      "vercel": false,
      "cloudflare": false
    },
    "commands": [
      {
        "cmd": "/memory",
        "desc": "Search saved memories — /memory <text> searches, it does not save",
        "method": "GET",
        "route": "/api/memory",
        "param": "q",
        "mode": "instant",
        "category": "content",
        "argHint": "<search text>",
        "rejectArg": {
          "pattern": "^\\s*(my |i am |i\\'m |remember |call me )",
          "error": "/memory SEARCHES your saved memories, it does not save. Nothing was saved.",
          "hint": "To save a memory, use /remember <text>."
        }
      },
      {
        "cmd": "/remember",
        "desc": "Save something to memory",
        "method": "POST",
        "route": "/api/memory/add",
        "param": "text",
        "mode": "instant",
        "category": "content"
      },
      {
        "cmd": "/context",
        "desc": "Pull the relevant memory context for a topic",
        "method": "GET",
        "route": "/api/memory/context",
        "param": "q",
        "mode": "instant",
        "category": "content"
      }
    ],
    "filesystem": {
      "beyondNamespace": [
        {
          "file": "api/memory.cjs",
          "scope": "vault",
          "reason": "Long-term memories live in the shared Vault so every block and the Second Brain can read them."
        }
      ]
    },
    "settings_keys": [],
    "settings": [
      {
        "key": "injection_budget",
        "label": "Injection budget (chars)",
        "type": "number",
        "default": 4500
      },
      {
        "key": "auto_distill",
        "label": "Auto-distill sessions",
        "type": "boolean",
        "default": true
      }
    ]
  },
  "routes": [
    {
      "method": "GET",
      "path": "/api/memory",
      "auth": true
    },
    {
      "method": "DELETE",
      "path": "/api/memory/:id",
      "auth": true
    },
    {
      "method": "PUT",
      "path": "/api/memory/:id",
      "auth": true
    },
    {
      "method": "POST",
      "path": "/api/memory/:id/pin",
      "auth": true
    },
    {
      "method": "POST",
      "path": "/api/memory/add",
      "auth": true
    },
    {
      "method": "GET",
      "path": "/api/memory/context",
      "auth": true
    },
    {
      "method": "POST",
      "path": "/api/memory/distill",
      "auth": true
    }
  ],
  "env": [],
  "ai": {
    "capabilities": [
      "analyze"
    ],
    "canGenerate": false,
    "canAnalyze": true,
    "canAutomate": false
  },
  "storage": {
    "provider": "json",
    "tables": [],
    "scope": "global"
  },
  "dependencies": [],
  "deployment": {
    "target": "local",
    "runtime": "nodejs"
  }
}