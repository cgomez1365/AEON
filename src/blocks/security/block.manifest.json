{
  "manifestVersion": "1.1.0",
  "id": "security",
  "label": "Security",
  "icon": "Shield",
  "route": "/security",
  "description": "The Guardian — password on every launch, idle auto-lock, encrypted sync-then-forget on walk-away, and a deployment shield that keeps CDNs from caching your data.",
  "category": "core",
  "tier": "core",
  "nav": {
    "group": "system",
    "order": 99,
    "label": "Security",
    "icon": "Shield",
    "iconAsset": "/brand/block-icons/security.svg",
    "iconAssetPng": "/brand/block-icons/png/security.png",
    "hidden": false
  },
  "widget": null,
  "requires": {
    "apis": [],
    "env": [],
    "local": [],
    "blocks": []
  },
  "provides": {
    "routes": true,
    "api": true,
    "models": []
  },
  "api_routes": true,
  "version": "2.0.0",
  "contract": {
    "inputs": [],
    "outputs": [],
    "events": [],
    "permissions": {
      "filesystem": "write",
      "network": "external",
      "secrets": true,
      "shell": false,
      "ai": false,
      "middleware": "early"
    },
    "storage": {
      "type": "json",
      "scope": "block",
      "local": {
        "indexed": false,
        "retention": "operational"
      },
      "access": "compatibility"
    },
    "memory": {
      "mode": "none",
      "indexed": false,
      "userConfigurable": false
    },
    "ai": {
      "canGenerate": false,
      "canAnalyze": false,
      "canAutomate": false,
      "roles": []
    },
    "targets": {
      "local": true,
      "vercel": true,
      "docker": true,
      "cloudflare": true
    },
    "commands": [
      {
        "cmd": "/lock",
        "desc": "Lock AEON now — revoke every session (and sync if enabled)",
        "method": "POST",
        "route": "/api/security/lock",
        "dangerous": true
      },
      {
        "cmd": "/flush",
        "desc": "Encrypt + sync sensitive stores to your own cloud now",
        "method": "POST",
        "route": "/api/security/flush"
      },
      {
        "cmd": "/guard",
        "desc": "Show protection status",
        "method": "GET",
        "route": "/api/security/policy",
        "template": "Guard: {policy.guardEnabled} · every-launch: {policy.lockEveryLaunch} · idle: {policy.idleMinutes}min · shield: {policy.shield} · runtime: {runtime}"
      }
    ],
    "settings_keys": [
      "security_policy"
    ],
    "settings": [
      {
        "key": "lockEveryLaunch",
        "label": "Ask for password every time AEON opens",
        "type": "boolean",
        "default": true
      },
      {
        "key": "idleMinutes",
        "label": "Auto-lock after minutes away",
        "type": "select",
        "options": [
          1,
          5,
          10,
          15,
          30,
          60
        ],
        "default": 5
      },
      {
        "key": "flushOnLock",
        "label": "Sync data to my cloud when AEON locks",
        "type": "boolean",
        "default": true
      },
      {
        "key": "shield",
        "label": "Deployment shield (no-store caching)",
        "type": "boolean",
        "default": true
      }
    ]
  },
  "routes": [
    {
      "method": "ALL",
      "path": "/security/*",
      "auth": true
    }
  ],
  "env": [],
  "ai": {
    "capabilities": [],
    "canGenerate": false,
    "canAnalyze": false,
    "canAutomate": false
  },
  "storage": {
    "provider": "json",
    "tables": [],
    "scope": "block"
  },
  "dependencies": [],
  "deployment": {
    "target": "universal",
    "runtime": "any"
  }
}