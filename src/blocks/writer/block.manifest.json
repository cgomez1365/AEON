{
  "manifestVersion": "1.1.0",
  "id": "writer",
  "label": "Writer",
  "icon": "PenLine",
  "route": "/writer",
  "description": "A full writing studio — documents, templates, version history, outline, focus mode, find & replace, AI co-writer with your Writing DNA, and one-click export to Word, HTML, Markdown, or PDF.",
  "category": "intel",
  "tier": "core",
  "nav": {
    "group": "system",
    "order": 99,
    "label": "Writer",
    "icon": "PenLine",
    "iconAsset": "/brand/block-icons/writer.svg",
    "iconAssetPng": "/brand/block-icons/png/writer.png",
    "hidden": false
  },
  "widget": null,
  "requires": {
    "apis": [],
    "env": [],
    "local": [],
    "blocks": []
  },
  "provides": {
    "routes": true,
    "api": true,
    "models": []
  },
  "api_routes": true,
  "version": "2.0.0",
  "contract": {
    "customizable": {
      "icon": true
    },
    "inputs": [],
    "outputs": [],
    "events": [],
    "permissions": {
      "filesystem": "write",
      "network": "internal",
      "secrets": false,
      "shell": false,
      "ai": true
    },
    "storage": {
      "type": "json",
      "scope": "block",
      "local": {
        "indexed": false,
        "retention": "operational"
      },
      "access": "compatibility"
    },
    "memory": {
      "mode": "document",
      "indexed": true,
      "userConfigurable": false
    },
    "ai": {
      "canGenerate": true,
      "canAnalyze": true,
      "canAutomate": false,
      "roles": [
        "creative"
      ]
    },
    "targets": {
      "local": true,
      "vercel": true,
      "cloudflare": true
    },
    "commands": [
      {
        "cmd": "/write",
        "desc": "Generate a draft — /write a follow-up email to a client",
        "method": "POST",
        "route": "/api/writer/generate",
        "param": "prompt",
        "display": "content"
      },
      {
        "cmd": "/docs",
        "desc": "List saved Writer documents",
        "method": "GET",
        "route": "/api/writer/docs"
      }
    ],
    "settings_keys": [
      "models.creative"
    ],
    "settings": []
  },
  "routes": [
    {
      "method": "POST",
      "path": "/api/writer/ai",
      "auth": true
    },
    {
      "method": "POST",
      "path": "/api/writer/cowrite",
      "auth": true
    },
    {
      "method": "POST",
      "path": "/api/writer/doc",
      "auth": true
    },
    {
      "method": "DELETE",
      "path": "/api/writer/doc/:id",
      "auth": true
    },
    {
      "method": "GET",
      "path": "/api/writer/doc/:id",
      "auth": true
    },
    {
      "method": "POST",
      "path": "/api/writer/doc/:id/to-memory",
      "auth": true
    },
    {
      "method": "GET",
      "path": "/api/writer/docs",
      "auth": true
    },
    {
      "method": "GET",
      "path": "/api/writer/export/:id.doc",
      "auth": true
    },
    {
      "method": "POST",
      "path": "/api/writer/generate",
      "auth": true
    },
    {
      "method": "POST",
      "path": "/api/writer/improve",
      "auth": true
    },
    {
      "method": "POST",
      "path": "/api/writer/restore/:id/:ts",
      "auth": true
    },
    {
      "method": "GET",
      "path": "/api/writer/style",
      "auth": true
    },
    {
      "method": "POST",
      "path": "/api/writer/style/analyze",
      "auth": true
    },
    {
      "method": "GET",
      "path": "/api/writer/templates",
      "auth": true
    },
    {
      "method": "GET",
      "path": "/api/writer/version/:id/:ts",
      "auth": true
    },
    {
      "method": "GET",
      "path": "/api/writer/versions/:id",
      "auth": true
    }
  ],
  "env": [],
  "ai": {
    "capabilities": [
      "generate",
      "analyze"
    ],
    "canGenerate": true,
    "canAnalyze": true,
    "canAutomate": false
  },
  "storage": {
    "provider": "json",
    "tables": [],
    "scope": "block"
  },
  "dependencies": [],
  "deployment": {
    "target": "universal",
    "runtime": "any"
  }
}