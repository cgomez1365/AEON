{
  "manifestVersion": "1.1.0",
  "id": "files",
  "label": "Files",
  "icon": "Folder",
  "route": "/files",
  "description": "File browser for this computer's own folders (the Vault first) — upload, new folder, rename, edit, delete behind an add-only lock. An optional Cloud pane and Cloud Notes need Supabase.",
  "category": "core",
  "tier": "core",
  "nav": {
    "group": "content",
    "order": 5,
    "label": "Files",
    "icon": "Folder",
    "iconAsset": "/brand/block-icons/files.svg",
    "iconAssetPng": "/brand/block-icons/png/files.png",
    "hidden": false
  },
  "widget": null,
  "requires": {
    "apis": [],
    "env": [],
    "local": [],
    "blocks": [
      "host_os"
    ]
  },
  "provides": {
    "routes": true,
    "api": true,
    "models": []
  },
  "api_routes": true,
  "version": "1.0.0",
  "contract": {
    "customizable": {
      "icon": true
    },
    "inputs": [],
    "outputs": [],
    "events": [],
    "permissions": {
      "filesystem": "write",
      "network": "external",
      "secrets": true,
      "shell": false,
      "ai": false
    },
    "storage": {
      "type": "none",
      "scope": "block",
      "local": {
        "indexed": false,
        "retention": "ephemeral"
      },
      "access": "compatibility"
    },
    "memory": {
      "mode": "summary",
      "indexed": true,
      "userConfigurable": false
    },
    "ai": {
      "canGenerate": false,
      "canAnalyze": false,
      "canAutomate": false,
      "roles": []
    },
    "targets": {
      "local": true,
      "vercel": true,
      "cloudflare": true
    },
    "commands": [],
    "settings_keys": [],
    "settings": []
  },
  "routes": [
    {
      "method": "DELETE",
      "path": "/api/notes",
      "auth": true
    },
    {
      "method": "GET",
      "path": "/api/notes",
      "auth": true
    },
    {
      "method": "POST",
      "path": "/api/notes",
      "auth": true
    },
    {
      "method": "PUT",
      "path": "/api/notes",
      "auth": true
    }
  ],
  "env": [],
  "ai": {
    "capabilities": [],
    "canGenerate": false,
    "canAnalyze": false,
    "canAutomate": false
  },
  "storage": {
    "provider": "json",
    "tables": [],
    "scope": "block"
  },
  "dependencies": [
    "host_os"
  ],
  "deployment": {
    "target": "hybrid",
    "runtime": "any"
  }
}