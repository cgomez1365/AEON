{
  "manifestVersion": "1.1.0",
  "id": "files",
  "label": "Files",
  "icon": "Folder",
  "route": "/files",
  "description": "File browser and document manager with cloud sync and Second Brain integration",
  "category": "core",
  "tier": "core",
  "nav": {
    "group": "content",
    "order": 5,
    "label": "Files",
    "icon": "Folder",
    "iconAsset": "/brand/block-icons/files.svg",
    "iconAssetPng": "/brand/block-icons/png/files.png",
    "hidden": false
  },
  "widget": null,
  "requires": {
    "apis": [
      "supabase"
    ],
    "env": [
      "SUPABASE_URL",
      "SUPABASE_SERVICE_ROLE_KEY"
    ],
    "local": [],
    "blocks": []
  },
  "provides": {
    "routes": true,
    "api": true,
    "models": []
  },
  "api_routes": true,
  "version": "1.0.0",
  "contract": {
    "inputs": [],
    "outputs": [],
    "events": [],
    "permissions": {
      "filesystem": "write",
      "network": "external",
      "secrets": true,
      "shell": false,
      "ai": false
    },
    "storage": {
      "type": "json",
      "scope": "block",
      "local": {
        "indexed": false,
        "retention": "operational"
      },
      "access": "compatibility"
    },
    "memory": {
      "mode": "summary",
      "indexed": true,
      "userConfigurable": false
    },
    "ai": {
      "canGenerate": false,
      "canAnalyze": false,
      "canAutomate": false,
      "roles": []
    },
    "targets": {
      "local": true,
      "vercel": true,
      "docker": true,
      "cloudflare": true
    },
    "commands": [
      {
        "cmd": "/read",
        "desc": "Read a file from the workspace",
        "method": "POST",
        "route": "/api/fs/read",
        "param": "filePath",
        "mode": "instant",
        "category": "content"
      },
      {
        "cmd": "/write",
        "desc": "Write a file in the workspace",
        "method": "POST",
        "route": "/api/fs/write",
        "params": [
          "filePath",
          "content"
        ],
        "dangerous": true,
        "mode": "instant",
        "category": "content"
      }
    ],
    "settings_keys": [],
    "settings": []
  },
  "routes": [
    {
      "method": "ALL",
      "path": "/files/*",
      "auth": true
    }
  ],
  "env": [
    "SUPABASE_URL",
    "SUPABASE_SERVICE_ROLE_KEY"
  ],
  "ai": {
    "capabilities": [],
    "canGenerate": false,
    "canAnalyze": false,
    "canAutomate": false
  },
  "storage": {
    "provider": "json",
    "tables": [],
    "scope": "block"
  },
  "dependencies": [],
  "deployment": {
    "target": "hybrid",
    "runtime": "any"
  }
}