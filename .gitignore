# Dependencies
node_modules/
.pnp
.pnp.js

# Build output
dist/
dist-electron/
build/

# Environment (contains API keys — use .env.example as template)
.env
.env.*
!.env.example

# Generated data (rebuild with: npm run index)
src/brain-data.json
.push-manifest.json
.sync-manifest.json

# Scratch / test-automation artifacts — browser profiles (cookies, login
# data, history), screenshots, temp PDFs. Never belongs in git; a browser
# profile got swept in via git add -A once, do not repeat that.
tmp/

# User data files (personal to each installation)
training-data.json
aeon_notes.json
aeon_terminal_history.json
chat_log.json
audit_log.json
clients.json
inventory.json
quick-links.json
user_html.json
token_ledger.json
sdi_violations.json
aeon-settings.json
blocks.json
cors.json

