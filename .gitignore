logs/
*.log
server.log
server_log.txt
scan_report.txt
detached_err.log
detached_out.log
npm-debug.log*

# Secrets
*.json.key
*firebase-adminsdk*.json
second-brain-*.json
firebase.json
firestore.rules

# One-shot patch scripts (dev artifacts, not distribution code)
patch_*.py
patch_*.js
replace_server*.js
rewrite_charts*.py
fix_server.py
build_v7.py
generate_static_includes.py
patch_vercel_api.js

# Test artifacts
test_ddg*.html
test_ddg*.js
test-build.js
test-models.js

