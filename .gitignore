aeon-endpoints.json.tmp

# ── AEON reorg: organized homes ──
secrets/
archive/
data/
Data/
tools/bin/cloudflared.exe

# AEON 3 additions
secrets/
data/
db/host-runtime.json
# BO-D2g — the per-call LLM ledger. Operator telemetry: what was asked of
# which model, when, and how long it took. Never committed.
db/llm_calls.jsonl
token_ledger.json
src/aeon-settings.json
src/blocks/*/data/
src/blocks/*/.aeon.runtime.json
*.log

# Per-block runtime data stores — a fresh clone must start at zero.
# activity_heatmap.json shipped one operator's request/token history to every
# consumer until 2026-07-29. readActivity() returns {} when absent.
src/blocks/*/db/*.json

# Native local runtime — generated state, never shipped (Phase 2)
data/local-runtime.json
data/local-runtime/

# BO-A2c empty-shell test tree (created and removed per run)
.aeon-empty-shell-test/

# ── BO-SHIP P3 — private operational roots (§07 Principle 04, §12/§15) ──
# Audit 2026-08-11 P0-04: none of these matched `git check-ignore`, so a locally
# created model or Vault credential could be staged by an ordinary `git add`.
# Both casings are listed deliberately: gitignore matching is case-sensitive on
# Linux and insensitive on Windows/macOS, and AEON claims all three.
models/
Models/
vault/
Vault/

# Runtime state written into db/, which otherwise holds tracked schema files.
# These are what a real first install creates; the tracked .sql and
# db/retrieval/_scopes.json are unaffected (this pattern matches direct
# children only).
db/*.json
!db/retrieval/_scopes.json
