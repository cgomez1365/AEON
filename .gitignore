__pycache__/

# Electron packaging
*.pfx

# Inbox (user content)
Inbox/

# Half-Baked (dev experiments)
Half-Baked/

# AEON auto-generated / secret artifacts (flashed on boot, never committed)
src/blocks/*/.aeon.runtime.json
aeon-vault.json
aeon-vault.json.tmp
aeon-keyslots.json
aeon-keyslots.json.tmp
aeon-user.json
aeon_user.json
