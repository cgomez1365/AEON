# === AEON — ENVIRONMENT CONFIGURATION ===
# The launcher copies this file to <AEON home>/.env on first run. Fill in only
# what you use. Every line is optional unless it says otherwise; the launcher
# writes the vault key for you.
# Every variable below is read by AEON's code (checked 2026-09-14).

# === AEON HOME (process environment ONLY — not this file) ===
# Everything AEON keeps for you lives in one folder outside the install:
# ~/AEON (C:\Users\<you>\AEON on Windows). Vault, models, keys, this .env,
# runtime state and settings all default to children of it, so the install
# can be read-only. Packs you install are the exception: they live in the
# install's src/blocks/ (see "Updating AEON" in the README).
#
# AEON_HOME moves that folder. It cannot be set HERE: this .env file lives
# inside the home, so it is read only after the home is known. Export it in
# your shell / launcher environment instead:
#   export AEON_HOME=/Volumes/Big/AEON        (macOS / Linux)
#   set AEON_HOME=D:\AEON                     (Windows)
# The per-root overrides below (VAULT_PATH, DATA_PATH, AEON_SECRETS_DIR,
# AEON_DB_DIR, AEON_SETTINGS_FILE, AEON_WORKSPACE) still work from this file
# and each wins over the home for its own root.
# AEON_HOME_MIGRATE=0 skips the one-time move of a pre-home install's data.

# === AEON WORKSPACE ===
# Where the File Manager, /read and the OS tools are rooted.
#
# Optional — defaults to the AEON home (~/AEON; services/storage.js).
# NOT your whole user profile: a consumer install should never greet its owner
# with that. Widen it here if you want AEON to reach other folders; /read also
# accepts an absolute path for one-off reads outside the workspace.
# AEON_WORKSPACE=

# === PROVIDER KEYS ===
# Usually added in AEON under Settings → Keys instead. A provider key written
# here is moved into the encrypted vault on the next start, and its line here
# is replaced by a comment saying so.
#
# A connection can hold several keys (the numbered _2, _3 … names). They are
# for failover across accounts or projects you are entitled to use: when one
# key is rate-limited, out of credit or rejected, AEON moves to the next. That
# is not a way around a provider's limits — whether a provider allows more
# than one account or key is set by its own terms; check them.

# === GEMINI (aistudio.google.com) ===
# Server-side only — used by the kernel LLM layer. The GEMINI_FREE_KEY_n names
# are kept so existing .env files keep working.
GEMINI_PAID_KEY=
GEMINI_FREE_KEY_1=
GEMINI_FREE_KEY_2=
GEMINI_FREE_KEY_3=

# === GROQ (console.groq.com) ===
GROQ_API_KEY=
GROQ_API_KEY_2=

# === OPENAI (platform.openai.com) ===
OPENAI_API_KEY=

# === ANTHROPIC / CLAUDE (console.anthropic.com) ===
ANTHROPIC_API_KEY=

# === GROK / xAI (console.x.ai) ===
GROK_API_KEY=

# === OPENROUTER (openrouter.ai — one API for many models) ===
OPENROUTER_API_KEY=

# === WEB SEARCH PROVIDERS ===
# At least one improves research quality significantly vs free DuckDuckGo scraping.
# Priority (auto mode): Tavily > Serper > Brave > DuckDuckGo
BRAVE_API_KEY=          # search.brave.com/search/api
SERPER_API_KEY=         # serper.dev — Google results
TAVILY_API_KEY=         # tavily.com — AI-optimized

# === SUPABASE (optional cloud mirror — free at supabase.com) ===
# Leave blank to stay fully local. AEON_LOCAL_ONLY=1 forces local even with keys.
SUPABASE_URL=
SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=
# Client-side (the anon key is public by design in Supabase)
VITE_SUPABASE_URL=
VITE_SUPABASE_ANON_KEY=

# === FIREBASE (optional — Google sign-in and cloud sync in the browser) ===
# VITE_ values are bundled into the browser build; these Firebase web-config
# values are public by design. Never put a secret key in a VITE_ variable.
VITE_FIREBASE_API_KEY=
VITE_FIREBASE_AUTH_DOMAIN=
VITE_FIREBASE_PROJECT_ID=
VITE_FIREBASE_STORAGE_BUCKET=
VITE_FIREBASE_MESSAGING_SENDER_ID=
VITE_FIREBASE_APP_ID=

# === YOUTUBE UPLOAD (optional — media pipeline) ===
YOUTUBE_CLIENT_ID=
YOUTUBE_CLIENT_SECRET=
YOUTUBE_REFRESH_TOKEN=

# === SECURITY ===
# Bearer token for headless callers (tunnels, scripts) — privileged OS
# operations also require it when no operator session is present.
AEON_MOBILE_SECRET=
# 32+ char master key for the AES-256-GCM vault. The launcher generates it on
# first run; set it yourself only when restoring a vault from elsewhere.
# Generate: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
AEON_VAULT_MASTER_KEY=
# Extra browser origins allowed by CORS (comma-separated), e.g. a tunnel host.
AEON_ALLOWED_ORIGINS=
# Set to 'production' in deployed environments — hides internal error detail from clients.
NODE_ENV=development
# Rate limiting (per IP). Defaults: 120 requests / 60000 ms.
AEON_RATE_WINDOW_MS=60000
AEON_RATE_MAX=120
# Set to 1 to enable a tuned Content-Security-Policy (audit asset sources first).
AEON_ENABLE_CSP=0
# Structured logging level: trace|debug|info|warn|error
AEON_LOG_LEVEL=info

# === TEXT RECOGNITION (OCR) ===
# Allow a one-time download of OCR English data from cdn.jsdelivr.net. Unset =
# images and scanned PDFs are not OCR'd until eng.traineddata is on disk.
# AEON_OCR_DOWNLOAD=1

# === LOCAL RUNTIME (optional — local models) ===
# Local models run in a llama.cpp worker that Cookbook downloads (a pinned,
# hash-checked release; it is not bundled with AEON) — no daemon, no host/port.
# There is no model env var: AEON reads whatever is actually installed from
# the runtime registry (local-runtime.json under <AEON home>/data/local-runtime),
# written by Cookbook.
# Preferred build when installing the runtime: cpu | cuda | metal | vulkan | rocm
AEON_LLM_BACKEND=cpu
