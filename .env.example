# === AEON COMMAND CENTER — ENVIRONMENT CONFIGURATION ===
# Copy this file to .env and fill in your values.

# === AEON WORKSPACE (set to your AEON root folder) ===
# Optional — defaults to the folder above the AEON install
# AEON_WORKSPACE=
VITE_# Optional — defaults to the folder above the AEON install
# AEON_WORKSPACE=

# === GEMINI KEY POOL (free keys from aistudio.google.com) ===
# Server-side only — used by kernel LLM service layer
GEMINI_PAID_KEY=
GEMINI_FREE_KEY_1=
GEMINI_FREE_KEY_2=
GEMINI_FREE_KEY_3=

# === GROQ KEY POOL (free at console.groq.com — add multiple accounts for rotation) ===
GROQ_API_KEY=
GROQ_API_KEY_2=
GROQ_API_KEY_3=

# === OPENAI (platform.openai.com) ===
OPENAI_API_KEY=

# === ANTHROPIC / CLAUDE (console.anthropic.com) ===
ANTHROPIC_API_KEY=

# === GROK / xAI (console.x.ai) ===
GROK_API_KEY=

# === OPENROUTER (openrouter.ai — unified API for 200+ models) ===
OPENROUTER_API_KEY=
OPENROUTER_API_KEY_2=

# === WEB SEARCH PROVIDERS ===
# At least one improves research quality significantly vs free DDG scraping.
# Priority (auto mode): Tavily > Serper > Brave > DuckDuckGo
BRAVE_API_KEY=          # search.brave.com/search/api — free 2k/mo
SERPER_API_KEY=         # serper.dev — Google results, free 2.5k/mo
TAVILY_API_KEY=         # tavily.com — AI-optimized, free 1k/mo

# === VITE_ CLIENT-SIDE KEYS (Vercel cloud fallback only) ===
# WARNING: VITE_ prefixed vars are bundled into client JavaScript.
# Only set these if deploying to Vercel AND using free-tier keys you accept as public.
# For localhost-only usage, leave blank — all LLM calls go through the server.
VITE_GROQ_API_KEY=
VITE_GEMINI_KEY=
VITE_GEMINI_KEY_2=

# === SUPABASE (free at supabase.com) ===
SUPABASE_URL=
SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=
# Client-side (anon key is public by design in Supabase)
VITE_SUPABASE_URL=
VITE_SUPABASE_ANON_KEY=

# === FIREBASE (optional — treasury sync) ===
VITE_FIREBASE_API_KEY=
VITE_FIREBASE_AUTH_DOMAIN=
VITE_FIREBASE_PROJECT_ID=
VITE_FIREBASE_STORAGE_BUCKET=
VITE_FIREBASE_MESSAGING_SENDER_ID=
VITE_FIREBASE_APP_ID=

# === GOOGLE APPS SCRIPT (optional — backup sync) ===
VITE_GAS_URL=

# === YOUTUBE AUTOPILOT (optional) ===
YOUTUBE_CLIENT_ID=
YOUTUBE_CLIENT_SECRET=
YOUTUBE_REFRESH_TOKEN=

# === SECURITY ===
# Bearer token required for external (tunnel/Vercel) API + all OS shell endpoints.
AEON_MOBILE_SECRET=
# 32+ char master key for the AES-256-GCM secret vault. REQUIRED if using the vault.
# Generate: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
AEON_VAULT_MASTER_KEY=
# Extra browser origins allowed by CORS (comma-separated). e.g. Cloudflare tunnel host.
AEON_ALLOWED_ORIGINS=
# Set to 'production' in deployed environments — hides internal error detail from clients.
NODE_ENV=development
# Rate limiting (per IP). Defaults: 120 requests / 60000 ms.
AEON_RATE_WINDOW_MS=60000
AEON_RATE_MAX=120
# Set to 1 to enable a tuned Content-Security-Policy (audit asset sources first).
AEON_ENABLE_CSP=0
# Structured logging level: trace|debug|info|warn|error
AEON_LOG_LEVEL=info

# === OLLAMA (optional — local LLM) ===
# OLLAMA_MODEL is intentionally left unset: AEON reads whatever's actually
# installed from data/local-runtime.json (Cookbook's registry) instead of a
# fixed tag. Set it here only to force a specific model regardless of what's
# pulled.
OLLAMA_HOST=http://localhost:11434
