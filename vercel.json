{
  "version": 2,
  "buildCommand": "npm run build",
  "outputDirectory": "dist",

  "rewrites": [
    {
      "source": "/api/search-web",
      "destination": "/api/search-web.js"
    },
    {
      "source": "/api/(.*)",
      "destination": "/api/index.js"
    },
    {
      "source": "/(.*)",
      "destination": "/index.html"
    }
  ],
  "crons": [
    {
      "path": "/api/sync/gas-backup",
      "schedule": "0 0 * * *"
    },
    {
      "path": "/api/cron/sweep",
      "schedule": "0 2 * * *"
    }
  ]
}