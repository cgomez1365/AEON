{
  "name": "aeon3",
  "description": "AEON Console — an AI-native operating system. Free console, capabilities as cartridges, run anywhere.",
  "author": "Broken Gear Industries <cristian@brokengear.io>",
  "private": true,
  "license": "Apache-2.0",
  "version": "3.0.0",
  "bin": {
    "aeon": "tools/aeon-cli.cjs"
  },
  "scripts": {
    "aeon": "node tools/aeon-cli.cjs",
    "dev": "vite",
    "build": "node tools/copy-assets.mjs && vite build",
    "prep:mounts": "node scripts/gen-vercel-mounts.cjs",
    "preview": "vite preview",
    "server": "node server.cjs",
    "brand:icons": "node tools/generate-aeon-brand-icons.mjs",
    "brand:block-icons": "node tools/generate-block-icons.mjs",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:coverage": "vitest run --coverage",
    "test:lr": "vitest run tests/local-runtime",
    "test:lr:unit": "vitest run tests/local-runtime --exclude \"**/*.stress.test.js\" --exclude \"**/*.integration.test.js\"",
    "test:lr:integration": "vitest run tests/local-runtime/**/*.integration.test.js",
    "test:lr:stress": "vitest run tests/local-runtime/**/*.stress.test.js",
    "scan:no-ollama": "node tools/scan/no-ollama.cjs",
    "scan:paths": "node tools/scan/path-authority.cjs",
    "scan:release-gate": "npm run scan:no-ollama && npm run scan:paths",
    "migrate": "node tools/migrate.cjs",
    "canary": "node tools/rls-canary.cjs",
    "start": "concurrently \"npm run dev\" \"npm run server\""
  },
  "devDependencies": {
    "axios": "^1.19.0",
    "chalk": "^4.1.2",
    "cli-progress": "^3.12.0",
    "glob": "^13.0.6",
    "inquirer": "^8.2.7",
    "typescript": "~6.0.2",
    "vite": "^5.4.21",
    "vite-plugin-pwa": "^1.3.0",
    "vitest": "^4.1.10",
    "wait-on": "^8.0.5"
  },
  "dependencies": {
    "@google/generative-ai": "^0.24.1",
    "@napi-rs/canvas": "^1.0.3",
    "@react-three/drei": "^10.7.7",
    "@react-three/fiber": "^9.6.1",
    "@supabase/supabase-js": "^2.111.0",
    "@vitejs/plugin-react-swc": "^3.11.0",
    "adm-zip": "^0.6.0",
    "chokidar": "^5.0.0",
    "concurrently": "^9.1.2",
    "cors": "^2.8.5",
    "dotenv": "^17.4.2",
    "express": "^4.21.2",
    "express-rate-limit": "^8.6.1",
    "ffmpeg-static": "^5.3.0",
    "firebase": "^12.16.0",
    "fluent-ffmpeg": "^2.1.3",
    "framer-motion": "^12.43.0",
    "googleapis": "^173.0.0",
    "helmet": "^8.3.0",
    "jspdf": "^4.2.1",
    "jspdf-autotable": "^5.0.8",
    "lucide-react": "^1.28.0",
    "mammoth": "^1.12.0",
    "mp4-muxer": "^5.2.2",
    "multer": "^2.2.0",
    "pdf-parse": "^1.1.4",
    "pdfjs-dist": "^6.2.108",
    "pino": "^10.3.1",
    "pino-pretty": "^13.1.3",
    "qrcode": "^1.5.4",
    "react": "^19.2.8",
    "react-dom": "^19.2.8",
    "react-force-graph-3d": "^1.29.1",
    "react-markdown": "^10.1.0",
    "react-router-dom": "^7.18.2",
    "recharts": "^3.10.1",
    "remark-gfm": "^4.0.1",
    "shell-quote": "^1.10.0",
    "supabase": "^2.110.0",
    "tar": "^7.5.16",
    "tesseract.js": "^7.0.0",
    "three": "^0.185.1",
    "ws": "^8.21.1"
  },
  "main": "vite.config.js",
  "directories": {
    "doc": "docs",
    "test": "tests"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/cgomez1365/AEON.git"
  },
  "bugs": {
    "url": "https://github.com/cgomez1365/AEON/issues"
  },
  "homepage": "https://github.com/cgomez1365/AEON#readme",
  "keywords": [],
  "type": "commonjs"
}
