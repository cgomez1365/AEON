{
  "name": "aeon",
  "description": "AEON — a local-first AI workspace built from governed blocks. Runs anywhere.",
  "author": "Broken Gear Industries <cristian@brokengear.io>",
  "private": true,
  "license": "SEE LICENSE IN LICENSE",
  "version": "3.0.0",
  "engines": {
    "node": ">=22.13.0"
  },
  "bin": {
    "aeon": "tools/aeon-cli.cjs"
  },
  "scripts": {
    "aeon": "node tools/aeon-cli.cjs",
    "dev": "vite",
    "build": "node scripts/gen-block-routes.cjs --check && node scripts/gen-block-docs.cjs && node tools/copy-assets.mjs && vite build",
    "prep:docs": "node scripts/gen-block-docs.cjs",
    "preview": "vite preview",
    "server": "node server.cjs",
    "brand:icons": "node tools/generate-aeon-brand-icons.mjs",
    "brand:block-icons": "node tools/generate-block-icons.mjs",
    "brand:banner": "node tools/generate-aeon-banner.mjs",
    "brand:banner:animate": "node tools/generate-aeon-banner.mjs --animate",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:coverage": "vitest run --coverage",
    "test:lr": "vitest run tests/local-runtime",
    "test:lr:unit": "vitest run tests/local-runtime --exclude \"**/*.stress.test.js\" --exclude \"**/*.integration.test.js\"",
    "test:lr:integration": "vitest run tests/local-runtime/**/*.integration.test.js",
    "test:lr:stress": "vitest run tests/local-runtime/**/*.stress.test.js",
    "scan:no-ollama": "node tools/scan/no-ollama.cjs",
    "scan:paths": "node tools/scan/path-authority.cjs",
    "scan:audit": "node tools/scan/audit-gate.cjs",
    "scan:release-gate": "npm run scan:no-ollama && npm run scan:paths && npm run scan:cloud-surface && npm run scan:block-fs",
    "scan:block-fs": "node tools/scan/block-fs-surface.cjs",
    "migrate": "node tools/migrate.cjs",
    "canary": "node tools/rls-canary.cjs",
    "start": "concurrently \"npm run dev\" \"npm run server\"",
    "prep:routes": "node scripts/gen-block-routes.cjs",
    "scan:cloud-surface": "node scripts/scan-cloud-surface.cjs",
    "scan:tree": "node tools/scan/tree-integrity.cjs",
    "test:verified": "node tools/scan/tree-integrity.cjs --snapshot && npm test && npm run scan:tree"
  },
  "devDependencies": {
    "concurrently": "^9.1.2",
    "jspdf": "^4.2.1",
    "vite": "^5.4.21",
    "vite-plugin-pwa": "^1.3.0",
    "vitest": "^4.1.9"
  },
  "dependencies": {
    "@napi-rs/canvas": "^1.0.9",
    "@supabase/supabase-js": "^2.105.4",
    "@vitejs/plugin-react-swc": "^3.11.0",
    "adm-zip": "^0.6.0",
    "cors": "^2.8.5",
    "dotenv": "^17.4.2",
    "express": "^4.21.2",
    "express-rate-limit": "^8.5.2",
    "ffmpeg-static": "^5.3.0",
    "firebase": "^12.13.0",
    "fluent-ffmpeg": "^2.1.3",
    "googleapis": "^173.0.0",
    "helmet": "^8.2.0",
    "lucide-react": "^1.14.0",
    "multer": "^2.3.0",
    "pdf-parse": "^1.1.4",
    "pdfjs-dist": "^4.10.38",
    "pino": "^10.3.1",
    "pino-pretty": "^13.1.3",
    "qrcode": "^1.5.4",
    "react": "^19.2.7",
    "react-dom": "^19.2.7",
    "react-markdown": "^10.1.0",
    "react-router-dom": "^7.15.1",
    "recharts": "^3.8.1",
    "remark-gfm": "^4.0.1",
    "tar": "^7.5.16",
    "tesseract.js": "^7.0.0",
    "ws": "^8.21.0"
  },
  "main": "vite.config.js",
  "directories": {
    "doc": "docs",
    "test": "tests"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/cgomez1365/AEON.git"
  },
  "bugs": {
    "url": "https://github.com/cgomez1365/AEON/issues"
  },
  "homepage": "https://github.com/cgomez1365/AEON#readme",
  "keywords": [],
  "type": "commonjs",
  "overrides": {
    "nanoid": "^3.3.17"
  }
}
